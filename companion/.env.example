# Database connection
DB_HOST=localhost
DB_NAME=postbop
DB_USER=postbop
DB_PASSWORD=replace-with-a-secure-password

# OAuth authorization sessions
# Lifetime in seconds (10 minutes)
OAUTH_SESSION_TTL=600

# Media storage
# Absolute filesystem path where uploaded images are stored
MEDIA_STORAGE_PATH=/absolute/path/to/media/storage

# Public URL corresponding to the media storage location
MEDIA_PUBLIC_BASE_URL=https://example.com/media

# Number of days uploaded images are retained
MEDIA_RETENTION_DAYS=180

# Maximum upload size in bytes (example: 10 MiB)
MEDIA_MAX_BYTES=10485760